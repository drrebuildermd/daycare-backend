# 로컬 개발용 예시. 실제 값은 backend/.env 에 넣고, Render 에서는
# 대시보드 > Environment 에 같은 이름으로 넣습니다. (.env 는 업로드하지 마세요)

# --- 필수 ---------------------------------------------------------------
# Supabase > Project Settings > API
# 서버에서는 반드시 service_role 키를 쓰세요. anon 키는 공개 키라서
# RLS를 켜면 백엔드가 데이터를 못 읽고, RLS를 끄면 외부에서 전량 조회가 가능합니다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=service_role_키를_여기에

# 주소 -> 좌표 변환용. Kakao Developers > 앱 키 > REST API 키
# (지도 표시에 쓰는 JavaScript 키와 다른 키입니다)
KAKAO_REST_API_KEY=

# --- 통신 --------------------------------------------------------------
# 이 API를 호출할 프론트엔드 주소를 쉼표로 나열합니다.
# "*" 는 아무 사이트나 호출할 수 있게 열어두는 것이라 운영에서는 피하세요.
CORS_ORIGINS=http://localhost:8081

# --- 배차 엔진 튜닝 (기본값으로 두어도 됩니다) --------------------------
AVERAGE_SPEED_KPH=25
ROAD_DISTANCE_FACTOR=1.25
STOP_SERVICE_MINUTES=3
TURNAROUND_MINUTES=5
# 솔버는 이 시간을 항상 끝까지 씁니다. 값을 키우면 경로가 조금 더 좋아지고,
# 줄이면 배차 버튼의 응답이 그만큼 빨라집니다.
SOLVER_TIME_LIMIT_SECONDS=10
