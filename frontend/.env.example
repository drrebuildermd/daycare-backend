# 실제 휴대폰(Expo Go)은 PC와 같은 Wi-Fi에 연결한 뒤 PC의 LAN IP를 입력하세요.
# 예: EXPO_PUBLIC_API_URL=http://192.168.0.15:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000


# 카카오맵 자바스크립트 키 (지도 표시용, REST API 키와 별개)
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 같은 앱의 [플랫폼] > [Web] 에 http://localhost:8081 등록 필요
EXPO_PUBLIC_KAKAO_JS_KEY=

# 관리자 화면 진입 PIN (오조작 방지용, 보안 장치 아님)
EXPO_PUBLIC_ADMIN_PIN=0000
